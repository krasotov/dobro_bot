# MAX Bot
MAX_BOT_TOKEN=your_token_here
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=change_me_to_random_string

# Database (docker-compose: host db)
DATABASE_URL=postgresql+asyncpg://bot:botpassword@db:5432/maxbot
POSTGRES_PASSWORD=change_me_db_password

# Admin panel (https://your-domain/admin/)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
SECRET_KEY=change_me_random_secret_for_sessions

# App
WEBHOOK_URL=https://your-bot-domain.example/webhook
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_API_VERIFY_SSL=false

# Optional: news / outage source chats in MAX
# NEWS_SOURCE_CHAT_ID=123456789
# OUTAGE_SOURCE_CHAT_ID=

# DaData — address normalization (recommended)
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Optional: machine API /internal/v1 (Bearer token)
# INTERNAL_API_TOKEN=generate-long-random-string

# Optional: external portal API (leave empty for standalone)
# ADMSPGO_API_URL=
# ADMSPGO_INTERNAL_TOKEN=

# Optional: operator dialog polling (MAX user ids, comma-separated)
# DIALOG_INBOX_POLL_CHAT_IDS=
