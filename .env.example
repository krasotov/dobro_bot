# MAX Bot
MAX_BOT_TOKEN=your_token_here
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=change_me_to_random_string

# Database
DATABASE_URL=postgresql+asyncpg://bot:botpassword@db:5432/maxbot

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
SECRET_KEY=change_me_random_secret_for_sessions

# App
WEBHOOK_URL=https://bot.xn--80agc6alen.xn--p1ai/webhook
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_API_VERIFY_SSL=false

# Optional: force news source chat_id (otherwise set automatically when bot is added to channel)
# NEWS_SOURCE_CHAT_ID=123456789

# DaData — нормализация адресов
DADATA_API_KEY=your_dadata_api_key
DADATA_SECRET_KEY=your_dadata_secret_key

# Read-only API для панели admspgo.ru (тот же токен в MAX_BOT_INTERNAL_TOKEN на VPS приложения)
# INTERNAL_API_TOKEN=generate-long-random-string

# Отправка обращений жителей в admspgo (тот же секрет, что MAX_BOT_INTERNAL_TOKEN на VPS приложения)
# ADMSPGO_API_URL=https://admspgo.ru
# ADMSPGO_INTERNAL_TOKEN=same-as-internal-api-token
